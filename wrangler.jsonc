{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "how-main-web",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "routes": [
    {
      "pattern": "house-of-wizard.xyz",
      "zone_name": "house-of-wizard.xyz",
      "custom_domain": true,
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://house-of-wizard.xyz",
    "SERVER_URL": "https://api.house-of-wizard.xyz",
    "VITE_APP_NAME": "House of Wizard",
  },
}
